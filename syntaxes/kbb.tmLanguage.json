{
    "scopeName": "source.kbb",
    "fileTypes": [
        "kbb"
    ],
    "name": "kbb",
    "patterns": [
        {
            "include": "#expression"
        }
    ],
    "repository": {
        "expression": {
            "name": "meta.expression.kbb",
            "patterns": [
                {
                    "include": "#comment-line"
                },
                {
                    "include": "#comment-block"
                },
                {
                    "include": "#top-concept"
                },
                {
                    "include": "#concept-name"
                },
                {
                    "include": "#concept-name1"
                },
                {
                    "include": "#concept-name2"
                },
                {
                    "include": "#attribute-name"
                },
                {
                    "include": "#attributes"
                },
                {
                    "include": "#qstring-double"
                }                
            ]
        },
        "top-concept": {
            "match": "^([\\w\\d]+)$",
            "name": "entity.name.type.level0.kbb"
        },
        "concept-name": {
            "name": "entity.name.type.level1.kbb",
            "match": "^[\\s][\\s][\\w\\d][^:^\\[]+[:]?"
        },
        "concept-name1": {
            "name": "entity.name.type.level2.kbb",
            "match": "^[\\s][\\s][\\s][\\s][\\w\\d][^:^\\[]+[:]?"
        },
        "concept-name2": {
            "name": "entity.name.type.level3.kbb",
            "match": "^[\\s][\\s][\\s][\\s][\\s][\\s][\\w\\d][^:^\\[]+[:]?"
        },
        "attribute-name": {
            "name": "constant.numeric.kbb",
            "match": "\\b[\\w\\d]+="
        },
        "attributes": {
            "begin": "\\[",
            "end": "\\]",
            "patterns": [
                {
                    "include": "#number"
                },
                {
                    "include": "#qstring-double"
                }
            ],
            "name": "meta.attribute.kbb"
        },
        "qstring-double": {
            "begin": "\"",
            "end": "\\\"|(?:[^\\\\\\n]$)",
            "name": "string.quoted.double.kbb",
            "patterns": [
                {
                    "include": "#string-character-escape"
                }
            ]
        },
        "string-character-escape": {
            "match": "\\\\(x\\h{2}|[0-2][0-7]{,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)",
            "name": "constant.character.escape.kbb"
        },
        "number": {
            "match": "\\b[\\d]+\\b",
            "name": "constant.numeric.kbb"
        },
        "comment-line": {
            "match": "\\s*#.*$\\n?",
            "name": "comment.line.kbb"
        },
        "comment-block": {
            "begin": "/\\*",
            "beginCaptures": {
                "0": {
                    "name": "comment.block.begin.kbb"
                }
            },
            "end": "\\*/",
            "endCaptures": {
                "0": {
                    "name": "comment.block.end.kbb"
                }
            },
            "name": "comment.block.kbb"
        }
    }
}